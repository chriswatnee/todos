# Response headers for Cloudflare static assets. Vite copies this file into
# dist/; Cloudflare reads it and does not serve it.
# The CSP is the CSP constant in vite.config.js plus frame-ancestors, which a
# <meta> tag can't set. tests/headers.test.js keeps the two in sync.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src https://api.todoist.com; img-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The HTML page only. no-transform stops Cloudflare Web Analytics from injecting
# its beacon script (the CSP would block it anyway; no third-party scripts run
# here). Web Analytics stays on for the rest of the zone. The other directives
# are Cloudflare's default for HTML: always revalidate.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
